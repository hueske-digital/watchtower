# Specify a timezone to use, e.g. Europe/Berlin.
TZ=Europe/Berlin

# Do not send a message after watchtower started. Otherwise there will be an info-level notification.
WATCHTOWER_NO_STARTUP_MESSAGE=true

# Enable debug mode with verbose logging.
WATCHTOWER_DEBUG=false

# Removes old images after updating.
WATCHTOWER_CLEANUP=true

# Schedules every day at four o'clock
WATCHTOWER_SCHEDULE=0 0 4 * * *

# Restart one image at time instead of stopping and starting all at once.
WATCHTOWER_ROLLING_RESTART=true

# Configure E-Mail notifications.
WATCHTOWER_NOTIFICATIONS=email
WATCHTOWER_NOTIFICATION_EMAIL_FROM=
WATCHTOWER_NOTIFICATION_EMAIL_TO=
WATCHTOWER_NOTIFICATION_EMAIL_SERVER=
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PORT=25
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_USER=
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PASSWORD=

WATCHTOWER_NOTIFICATIONS_HOSTNAME=ThinkCentre

# HTTP API (Port 8080)
# Sobald hier ein Token steht, aktiviert docker-compose.yml automatisch den
# Endpunkt /v1/update. Damit kann z. B. eine CI-Pipeline den Deploy sofort
# anstoßen, statt bis zum nächsten WATCHTOWER_SCHEDULE zu warten.
# Bleibt das Feld leer, bleibt die API aus - Watchtower würde sonst den Start
# verweigern (ein authentifizierter Endpunkt ohne Token ist ein Konfigurations-
# fehler) und mit restart:unless-stopped endlos neu starten.
# Der Token gehört behandelt wie ein Passwort: Über CADDY_DOMAIN ist der
# Endpunkt öffentlich erreichbar.
WATCHTOWER_HTTP_API_TOKEN=

# Trotz gesetztem Token abschalten: WATCHTOWER_HTTP_API_ENDPOINTS= (leer)
# Zeitplan trotz aktiver API abschalten: WATCHTOWER_HTTP_API_PERIODIC_POLLS=false
# (docker-compose.yml setzt hier true, damit der Zeitplan erhalten bleibt)

# Caddy Autodiscovery
# Pflicht, wenn die HTTP-API von außen erreichbar sein soll (z. B. damit eine
# CI-Pipeline den Deploy anstößt). Der Endpunkt steht damit öffentlich im Netz -
# einziger Schutz ist WATCHTOWER_HTTP_API_TOKEN.
CADDY_DOMAIN=watchtower.example.com
